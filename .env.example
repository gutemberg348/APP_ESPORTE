POSTGRES_USER=nacional
POSTGRES_PASSWORD=nacional_local_only
POSTGRES_DB=nacional
POSTGRES_PORT=55432
API_PORT=3333
# npm run setup gera este segredo quando vazio. Necessário no perfil Docker full.
CARD_TOKEN_SECRET=
# Gerado por npm run setup para o perfil Docker da API.
JWT_SECRET=
TICKET_QR_SECRET=
# Perfil Docker full. No desenvolvimento local, configure apps/api/.env.
PAYMENT_MODE=disabled
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_WEBHOOK_URL=
ASAAS_WEBHOOK_EMAIL=
ASAAS_DATA_SECRET=
ASAAS_MERCHANT_WALLETS={}
TENANT_SLUG=nacional-patos
MELHOR_ENVIO_ENVIRONMENT=sandbox
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_CONTACT_EMAIL=
MELHOR_ENVIO_SERVICES=1,2
# Recuperação de senha: credenciais somente no backend.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Sócio Esporte"
PASSWORD_RESET_PUBLIC_URL=http://localhost:8081/reset-password
PASSWORD_RESET_TTL_MINUTES=15
MAIL_DATA_SECRET=
MAIL_WORKER_INTERVAL_MS=3000

# Pix Sicredi no perfil Docker full (certificados montados somente para leitura).
# Depois de configurar, escolha PAYMENT_MODE=sicredi.
SICREDI_PIX_ENV=production
SICREDI_PIX_API_URL=https://api-pix.sicredi.com.br/api/v2
SICREDI_PIX_AUTH_URL=https://api-pix.sicredi.com.br/oauth/token
SICREDI_PIX_CLIENT_ID=
SICREDI_PIX_CLIENT_SECRET=
SICREDI_PIX_RECEIVING_KEY=
SICREDI_CERTS_DIRECTORY=./.secrets/sicredi
SICREDI_PIX_CERT_PASSPHRASE=
SICREDI_PIX_TXID_PREFIX=ESP
SICREDI_PIX_TIMEOUT_MS=10000
SICREDI_PIX_WEBHOOK_TOKEN=
SICREDI_PIX_WEBHOOK_URL=https://sua-api.com.br/v1/payments/webhooks/sicredi
