# VPS Ubuntu: este arquivo configura os três containers (banco, API e frontend).
POSTGRES_USER=nacional
POSTGRES_PASSWORD=
POSTGRES_DB=nacional
POSTGRES_PORT=55432
API_PORT=3333
# Setup preenche UID/GID do usuário server para ler a pasta de certificados com modo 700.
API_UID=
API_GID=
WEB_PORT=8080
# Rede privada. Se houver conflito, altere subnet e gateway juntos.
DOCKER_NETWORK_SUBNET=172.30.77.0/24
DOCKER_NETWORK_GATEWAY=172.30.77.1
# npm run setup gera este segredo quando vazio. Necessário no perfil Docker full.
CARD_TOKEN_SECRET=
# Gerado por npm run setup para o perfil Docker da API.
JWT_SECRET=
TICKET_QR_SECRET=
# Docker na VPS: configure aqui. No desenvolvimento Node local, use apps/api/.env.
PAYMENT_MODE=disabled
TENANT_SLUG=nacional-patos
MELHOR_ENVIO_ENVIRONMENT=sandbox
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_CONTACT_EMAIL=
MELHOR_ENVIO_SERVICES=1,2
# Recuperação de senha: credenciais somente no backend.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Sócio Esporte"
PASSWORD_RESET_PUBLIC_URL=https://esporte.testes-techcode.shop/reset-password
PASSWORD_RESET_TTL_MINUTES=15
MAIL_DATA_SECRET=
MAIL_WORKER_INTERVAL_MS=3000

# Pix Sicredi na VPS (certificados montados somente para leitura).
# Depois de configurar, escolha PAYMENT_MODE=sicredi.
SICREDI_PIX_ENV=production
SICREDI_PIX_API_URL=https://api-pix.sicredi.com.br/api/v2
SICREDI_PIX_AUTH_URL=https://api-pix.sicredi.com.br/oauth/token
SICREDI_PIX_CLIENT_ID=
SICREDI_PIX_CLIENT_SECRET=
SICREDI_PIX_RECEIVING_KEY=
SICREDI_CERTS_DIRECTORY=/etc/nacional/certificados
SICREDI_PIX_CERT_PASSPHRASE=
SICREDI_PIX_TXID_PREFIX=ESP
SICREDI_PIX_TIMEOUT_MS=10000
SICREDI_PIX_WEBHOOK_TOKEN=
SICREDI_PIX_WEBHOOK_URL=https://api-esporte.testes-techcode.shop/v1/payments/webhooks/sicredi

# Valores públicos incorporados ao build do frontend.
EXPO_PUBLIC_API_URL=https://api-esporte.testes-techcode.shop/v1
EXPO_PUBLIC_CLUB=esporte

CORS_ORIGINS=https://esporte.testes-techcode.shop

# Conta administrativa inicial; setup gera senha apenas se estiver vazia.
ADMIN_EMAIL=
ADMIN_NAME=Administrador Esporte
ADMIN_PASSWORD=
