# Opcional: copie para apps/mobile/.env.android.local. O comando já usa estes padrões públicos.
# Nunca coloque credenciais da API, banco, SMTP ou Sicredi em EXPO_PUBLIC_*.
EXPO_PUBLIC_API_URL=https://api-esporte.testes-techcode.shop/v1
EXPO_PUBLIC_CLUB=esporte
EXPO_PUBLIC_TENANT_SLUG=nacional-patos

# Opcional: caminhos deste computador. Sem preencher, usa o ambiente/Android Studio.
ANDROID_JAVA_HOME=
ANDROID_SDK_ROOT=

# Opcional: reutilizar uma chave Android própria. Preencha os quatro ou deixe todos vazios.
# Caminho absoluto ou relativo à raiz do repositório; não colocar a chave dentro de android/.
# Se vazios, local:app cria e reutiliza uma chave em .secrets/android/<package>/.
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
