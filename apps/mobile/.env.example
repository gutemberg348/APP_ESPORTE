# true: protótipo navegável com dados locais; false: login e API real.
EXPO_PUBLIC_DEMO_MODE=false
# Identidade visual: esporte (inicial) ou nacional. Não altera dados/tenants do banco.
EXPO_PUBLIC_CLUB=esporte
# Expo Go em desenvolvimento: localhost é resolvido para o host do Expo no celular.
# Para fixar outra API ou usar tunnel, informe o IP LAN/URL acessível explicitamente.
# Emulador Android: http://10.0.2.2:3333/v1
EXPO_PUBLIC_API_URL=http://localhost:3333/v1
EXPO_PUBLIC_TENANT_SLUG=nacional-patos
