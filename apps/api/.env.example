NODE_ENV=development
HOST=0.0.0.0
PORT=3333
DATABASE_URL=postgresql://nacional:nacional_local_only@localhost:55432/nacional?schema=public
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://127.0.0.1:8081,http://127.0.0.1:8082,http://localhost:19006
# Desenvolvimento local. Substitua por um segredo aleatório antes de publicar.
CARD_TOKEN_SECRET=nacional-local-development-card-secret-change-before-production
SESSION_TTL_DAYS=7
JWT_SECRET=
JWT_ISSUER=nacional-api
JWT_AUDIENCE=nacional-app
JWT_ACCESS_TTL_SECONDS=900
TICKET_QR_SECRET=
SEED_DEMO_PASSWORD=NacionalDemo123!
# disabled: recebimento manual; demo: simulação local; asaas: Pix automático.
PAYMENT_MODE=disabled
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
# Token exclusivo do webhook (32–255 caracteres sem espaços), não é a API key.
ASAAS_WEBHOOK_TOKEN=
# Opcionais para npm run payments:webhook (URL HTTPS final e email de alertas).
ASAAS_WEBHOOK_URL=
ASAAS_WEBHOOK_EMAIL=
# Segredo aleatório de 64+ caracteres para criptografar documentos dos pagadores.
ASAAS_DATA_SECRET=
# Mapa JSON merchantId local -> walletId da conta Asaas recebedora, no mesmo ambiente.
ASAAS_MERCHANT_WALLETS={}
ASAAS_TIMEOUT_MS=10000
PAYMENT_WORKER_INTERVAL_MS=3000
# Cotação de frete Melhor Envio. Token somente na API; a integração não compra etiquetas.
MELHOR_ENVIO_ENVIRONMENT=sandbox
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_CONTACT_EMAIL=
# 1 e 2: serviços Correios; vazio permite serviços habilitados na sua conta.
MELHOR_ENVIO_SERVICES=1,2
TENANT_SLUG=nacional-patos
ADMIN_EMAIL=admin@nacional.local
ADMIN_NAME=Administrador Nacional
# Defina uma senha de pelo menos 12 caracteres antes de executar db:bootstrap.
ADMIN_PASSWORD=
TICKET_PAYMENT_INSTRUCTIONS=Após reservar, apresente o número da reserva no atendimento do clube. O ingresso é emitido quando o administrador confirmar o pagamento recebido.
