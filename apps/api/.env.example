NODE_ENV=development
HOST=0.0.0.0
PORT=3333
DATABASE_URL=postgresql://nacional:nacional_local_only@localhost:55432/nacional?schema=public
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://127.0.0.1:8081,http://127.0.0.1:8082,http://localhost:19006
# Desenvolvimento local. Substitua por um segredo aleatório antes de publicar.
CARD_TOKEN_SECRET=nacional-local-development-card-secret-change-before-production
SESSION_TTL_DAYS=7
JWT_SECRET=
JWT_ISSUER=nacional-api
JWT_AUDIENCE=nacional-app
JWT_ACCESS_TTL_SECONDS=900
TICKET_QR_SECRET=
SEED_DEMO_PASSWORD=NacionalDemo123!
# disabled: manual; demo: simulação; sicredi: Pix; asaas: compatibilidade anterior.
PAYMENT_MODE=disabled

# Pix Sicredi: preencher os dados privados e depois definir PAYMENT_MODE=sicredi.
SICREDI_PIX_ENV=production
# Produção usa estas URLs. Homologação: use as URLs fornecidas pelo Sicredi.
SICREDI_PIX_API_URL=https://api-pix.sicredi.com.br/api/v2
SICREDI_PIX_AUTH_URL=https://api-pix.sicredi.com.br/oauth/token
SICREDI_PIX_CLIENT_ID=
SICREDI_PIX_CLIENT_SECRET=
SICREDI_PIX_RECEIVING_KEY=
# Caminhos relativos à pasta apps/api, ou caminhos absolutos privados.
SICREDI_PIX_CERT_PATH=../../.secrets/sicredi/cliente.cer
SICREDI_PIX_KEY_PATH=../../.secrets/sicredi/cliente.key
SICREDI_PIX_CHAIN_PATH=../../.secrets/sicredi/cadeia.cer
SICREDI_PIX_CERT_PASSPHRASE=
SICREDI_PIX_TXID_PREFIX=ESP
SICREDI_PIX_TIMEOUT_MS=10000
# Token exclusivo, aleatório, com 32–128 caracteres. Não é enviado ao app.
SICREDI_PIX_WEBHOOK_TOKEN=
# Base HTTPS, SEM token no final. O comando payments:webhook acrescenta o token.
SICREDI_PIX_WEBHOOK_URL=https://sua-api.com.br/v1/payments/webhooks/sicredi

# Asaas: somente para contas/cobranças antigas ou operação explícita do provedor.
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
# Token exclusivo do webhook (32–255 caracteres sem espaços), não é a API key.
ASAAS_WEBHOOK_TOKEN=
# Opcionais para npm run payments:webhook (URL HTTPS final e email de alertas).
ASAAS_WEBHOOK_URL=
ASAAS_WEBHOOK_EMAIL=
# Segredo aleatório de 64+ caracteres para criptografar documentos dos pagadores.
ASAAS_DATA_SECRET=
# Legado: mapa JSON merchantId -> walletId do ambiente atual. Novos recebedores
# devem ser configurados em Parceiros no admin, separados por sandbox/produção.
# Campo editado no admin prevalece; vazio no admin desabilita aquele recebedor.
ASAAS_MERCHANT_WALLETS={}
ASAAS_TIMEOUT_MS=10000
PAYMENT_WORKER_INTERVAL_MS=3000
# Cotação de frete Melhor Envio. Token somente na API; a integração não compra etiquetas.
MELHOR_ENVIO_ENVIRONMENT=sandbox
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_CONTACT_EMAIL=
# 1 e 2: serviços Correios; vazio permite serviços habilitados na sua conta.
MELHOR_ENVIO_SERVICES=1,2
TENANT_SLUG=nacional-patos
ADMIN_EMAIL=admin@nacional.local
ADMIN_NAME=Administrador Nacional
# Defina uma senha de pelo menos 12 caracteres antes de executar db:bootstrap.
ADMIN_PASSWORD=
TICKET_PAYMENT_INSTRUCTIONS=Após reservar, apresente o número da reserva no atendimento do clube. O ingresso é emitido quando o administrador confirmar o pagamento recebido.

# Recuperação de senha: credenciais somente no backend.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Sócio Esporte"
PASSWORD_RESET_PUBLIC_URL=http://localhost:8081/reset-password
PASSWORD_RESET_TTL_MINUTES=15
MAIL_DATA_SECRET=
MAIL_WORKER_INTERVAL_MS=3000
